{
  "name": "last-one-in-the-box",
  "version": "1.0.0",
  "private": true,
  "description": "A vertical 3D Remotion short about the last person in a shrinking box.",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts BoxChallenge out/still.png --frame=150",
    "render": "remotion render src/index.ts BoxChallenge out/silent.mp4 --codec=h264 --muted --crf=16 --pixel-format=yuv420p --scale=1 --gl=angle",
    "audio": "python tools/make_audio.py",
    "mux": "bash scripts/mux.sh out/silent.mp4 out/soundtrack.wav out/final.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.169.0",
    "typescript": "5.6.3"
  }
}
